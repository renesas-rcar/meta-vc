/dts-v1/;
/plugin/;

//This is an example overlay to re-configure the T1S PLCA schedule

//1. Remove the driver
// rmmod lan865x_mod
//
//2. compile this file
// dtc -I dts -O dtb -o t1s0.dtbo t1s0.dts
//
//3. create a new overlay place (only once)
// mkdir /sys/kernel/config/device-tree/overlays/t1s
//
//4. make the overlay active
// cat t1s0.dtbo > /sys/kernel/config/device-tree/overlays/t1s/dtbo
//
//5. Load the t1s driver (lan865x_mod.ko)
// insmod/modprobe


&mspi0 {
	status = "okay";

	pinctrl-0 = <&mspi0_pins>;
	pinctrl-names = "default";

	t1s@0 {
		plca-enable = /bits/ 8 <1>;
		plca-node-id = /bits/ 8 <0>; /* PLCA node id range: 0 to 254 */
		plca-node-count = /bits/ 8 <4>; /* PLCA node count range: 1 to 255 */
	};
};
