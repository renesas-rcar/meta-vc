From 21a61c4dc9afe88e5fab745286d5f1337d4b05d8 Mon Sep 17 00:00:00 2001
From: "Christian@p620" <christian.mardmoeller@renesas.com>
Date: Wed, 17 May 2023 19:25:40 +0600
Subject: [PATCH 57/92] drivers: net: lan865x: updates based on Microchip
 meeting

---
 drivers/net/ethernet/microchip/lan865x/lan865x.c | 8 ++++++--
 drivers/net/ethernet/microchip/lan865x/tc6.c     | 2 +-
 2 files changed, 7 insertions(+), 3 deletions(-)

diff --git a/drivers/net/ethernet/microchip/lan865x/lan865x.c b/drivers/net/ethernet/microchip/lan865x/lan865x.c
index 24ca15a29d2f..f4f564e6f78d 100755
--- a/drivers/net/ethernet/microchip/lan865x/lan865x.c
+++ b/drivers/net/ethernet/microchip/lan865x/lan865x.c
@@ -375,7 +375,7 @@ static bool lan865x_init(struct lan865x_priv *priv)
 		while (i < TC6_MEMMAP_LENGTH) {
 			success = Tc6_WriteRegister(priv, TC6_MEMMAP[i].address, TC6_MEMMAP[i].value);
 			if (!success) {
-				dev_err(&priv->spi->dev, "Initial register write failed\n");
+				dev_err(&priv->spi->dev, "Initial register write failed at %d\n", i);
 				break;
 			}
 			i++;
@@ -909,9 +909,12 @@ static int lan865x_probe(struct spi_device *spi)
 	}
 
 	if (priv->plca_enable)
-		netdev_info(netdev, "PLCA mode is active\n");
+		netdev_info(netdev, "PLCA mode is active (node-count=%d  node-id=%d)\n",
+				priv->plca_node_count, priv->plca_node_id);
 	else
 		netdev_info(netdev, "CSMA/CD mode is active\n");
+	netdev_info(netdev, "Tx mode is %s\n",
+			(priv->tx_cut_thr_mode) ? "cut-through" : "store-forward");
 
 	return 0;
 
@@ -981,6 +984,7 @@ MODULE_DESCRIPTION(DRV_NAME " 10Base-T1S MACPHY Ethernet Driver");
 MODULE_AUTHOR("Parthiban Veerasooran <Parthiban.Veerasooran@microchip.com>");
 MODULE_AUTHOR("Thorsten Kummermehr <Thorsten.Kummermehr@microchip.com>");
 MODULE_LICENSE("GPL");
+MODULE_VERSION(DRV_VERSION);
 module_param_named(debug, debug.msg_enable, int, 0);
 MODULE_PARM_DESC(debug, "Debug verbosity level in amount of bits set (0=none, ..., 31=all)");
 module_param_named(enable, plca_enable, byte, 0660);
diff --git a/drivers/net/ethernet/microchip/lan865x/tc6.c b/drivers/net/ethernet/microchip/lan865x/tc6.c
index 9a30fd9a61c4..aa1d9ade56a9 100755
--- a/drivers/net/ethernet/microchip/lan865x/tc6.c
+++ b/drivers/net/ethernet/microchip/lan865x/tc6.c
@@ -972,7 +972,7 @@ static uint16_t process_tx(TC6_t *g, uint8_t *tx_buf)
         if (g->prot.offsetEth == entry->len) {
             if (entry->len < TC6_CHUNK_SIZE) {
                 /* Test hack to round up tiny Ethernet frames to full chunk size. */
-		header |= MK_MASK(HDR_EV, 1u) | MK_MASK(HDR_EBO, TC6_CHUNK_SIZE - 5u);
+		header |= MK_MASK(HDR_EV, 1u) | MK_MASK(HDR_EBO, TC6_CHUNK_SIZE - 1u);
             } else {
                 header |= MK_MASK(HDR_EV, 1u) | MK_MASK(HDR_EBO, tocopy_len - 1u);
             }
-- 
