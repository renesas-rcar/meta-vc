- */
-#ifndef REG_OP_ARRAY_SIZE
-#define REG_OP_ARRAY_SIZE   (12)
-#endif
-
-/**
- * \brief Defines the maximum burst length of an SPI transfer. Meaning number of TC6 chunks with a single SPI transaction.
