-	rs_write32(GENMASK(RSWITCH_NUM_HW - 1, 0) | RCEC_RCE, priv->addr + RCEC);
+	rswitch_write(priv, RCEC, GENMASK(RSWITCH_NUM_HW - 1, 0) | RCEC_RCE);
