-		rswitch_agent_clock_ctrl(rdev->priv->addr, rdev->port, 1);
+	if (!rswitch_agent_clock_is_enabled(rdev->priv, rdev->port))
+		rswitch_agent_clock_ctrl(rdev->priv, rdev->port, 1);
 
