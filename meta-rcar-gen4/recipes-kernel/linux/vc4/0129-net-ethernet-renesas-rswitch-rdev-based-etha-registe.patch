@@ -1723,8 +1735,8 @@ static int rswitch_etha_hw_init(struct rswitch_device *rdev)
 	if (err < 0)
 		return err;
 
-	rs_write32(EAVCC_VEM_SC_TAG, etha->addr + EAVCC);
-	rswitch_etha_enable_mii(etha);
+	rdev_etha_write(rdev, EAVCC, EAVCC_VEM_SC_TAG);
