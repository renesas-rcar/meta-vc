-		ret = rswitch_reg_wait(etha->addr, MMIS1, MMIS1_PRACS, MMIS1_PRACS);
+		ret = rdev_etha_poll(rdev, MMIS1, MMIS1_PRACS, MMIS1_PRACS);
 		if (ret)
 			return ret;
 
 		/* Read data */
