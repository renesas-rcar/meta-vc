From 2000c0688d62c46c796df225ddca7f15bcbfa0dc Mon Sep 17 00:00:00 2001
From: Nikita Yushchenko <nikita.yoush@cogentembedded.com>
Date: Mon, 14 Oct 2024 10:10:13 +0500
Subject: [PATCH 155/157] net: ethernet: renesas: rswitch: xen frontend/backend
 drivers for vports

Signed-off-by: Nikita Yushchenko <nikita.yoush@cogentembedded.com>

diff --git a/drivers/net/ethernet/renesas/Kconfig b/drivers/net/ethernet/renesas/Kconfig
index 9ba5e37f899c..253c395096f1 100644
--- a/drivers/net/ethernet/renesas/Kconfig
+++ b/drivers/net/ethernet/renesas/Kconfig
@@ -66,6 +66,16 @@ config RENESAS_ETHER_SWITCH_VPORT_LOCAL
 	tristate "Local rswitch virtual port"
 	depends on RENESAS_ETHER_SWITCH
 
+config RENESAS_ETHER_SWITCH_XENBACK
+	tristate "Xen backend device for rswitch virtual port"
+	depends on RENESAS_ETHER_SWITCH && XEN_BACKEND
+
+config RENESAS_ETHER_SWITCH_XENFRONT
+	tristate "Xen frontend device for rswitch virtual port"
+	depends on XEN
+	select XEN_XENBUS_FRONTEND
+	select RENESAS_ETHER_SWITCH_LIB
+
 config RTSN
         tristate "Renesas Ethernet-TSN support"
         depends on ARCH_RENESAS || COMPILE_TEST
