From 485bf77ab982530ca900027b6e46cc3239798f1f Mon Sep 17 00:00:00 2001
From: "Christian@p620" <Christian@p620>
Date: Mon, 19 Sep 2022 16:52:12 +0200
Subject: [PATCH 102/151] Update DTS to have number from EEPROM on all
 interfaces

---
 arch/arm64/boot/dts/renesas/r8a779f0-vc4.dts | 28 ++++++++++----------
 1 file changed, 14 insertions(+), 14 deletions(-)

diff --git a/arch/arm64/boot/dts/renesas/r8a779f0-vc4.dts b/arch/arm64/boot/dts/renesas/r8a779f0-vc4.dts
index a7d9e8bc04ab..616916b49d7a 100644
--- a/arch/arm64/boot/dts/renesas/r8a779f0-vc4.dts
+++ b/arch/arm64/boot/dts/renesas/r8a779f0-vc4.dts
@@ -114,7 +114,7 @@
 
 		label = "board-data";
 		pagesize = <8>;
-		
+
 		rswitch2_gw_mac: rsw2gwmac@720 {
 			reg = <0x720 0x06>;
 		};
@@ -302,14 +302,14 @@
 
 &rswitch {
 	status = "okay";
-	
-	/* MAC address of the gateway port */
+
+	/* MAC address of the gateway port sw0 */
 	nvmem-cells = <&rswitch2_gw_mac>;
 	nvmem-cell-names = "mac-address";
-	
-	/* To be overwritten by bootloader or manually */
-	mac-address = [74 90 50 00 00 CC];
-	
+
+	/* All 00 to be overwritten by bootloader or manually */
+	mac-address = [00 00 00 00 00 00];
+
 	ports {
 		tsn0: port@0 {
 			phy-mode = "sgmii";
@@ -317,7 +317,7 @@
 			nvmem-cells = <&rswitch2_port0_mac>;
 			nvmem-cell-names = "mac-address";
 
-			/* To be overwritten by bootloader or manually */
+			/* All 00 to be overwritten by bootloader or manually */
 			mac-address = [00 00 00 00 00 00];
 
 
@@ -335,12 +335,12 @@
 		};
 		tsn1: port@1 {
 			phy-mode = "sgmii";
-			
+
 			nvmem-cells = <&rswitch2_port1_mac>;
 			nvmem-cell-names = "mac-address";
 
-			/* To be overwritten by bootloader or manually */
-			mac-address = [74 90 50 00 00 77];
+			/* All 00 to be overwritten by bootloader or manually */
+			mac-address = [00 00 00 00 00 00];
 
 			/* phy-handle set via plugin */
 			tsn1_phy_2g5: ethernet-phy@0 {
@@ -356,11 +356,11 @@
 		};
 		tsn2: port@2 {
 			phy-mode = "sgmii";
-/*
+
 			nvmem-cells = <&rswitch2_port2_mac>;
 			nvmem-cell-names = "mac-address";
-*/
-			/* To be overwritten by bootloader or manually */
+
+			/* All 00 to be overwritten by bootloader or manually */
 			mac-address = [00 00 00 00 00 00];
 
 
-- 
2.17.1

