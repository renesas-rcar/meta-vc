From 5ea455825193dbb0702b7b0ec22c2253eee72a37 Mon Sep 17 00:00:00 2001
From: "Christian@p620" <Christian@p620>
Date: Tue, 16 Aug 2022 16:17:04 +0200
Subject: [PATCH 073/151] Update CAN multiplexer pins

---
 arch/arm64/boot/dts/renesas/r8a779f0-vc4-ctrl-domain.dts | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/arch/arm64/boot/dts/renesas/r8a779f0-vc4-ctrl-domain.dts b/arch/arm64/boot/dts/renesas/r8a779f0-vc4-ctrl-domain.dts
index 49d387b06e9d..91575ac0c329 100644
--- a/arch/arm64/boot/dts/renesas/r8a779f0-vc4-ctrl-domain.dts
+++ b/arch/arm64/boot/dts/renesas/r8a779f0-vc4-ctrl-domain.dts
@@ -3,7 +3,7 @@
  * Device Tree Source for the VC4 vehicle computer board
  * This device requires full access for CA55 cores (application domain) to
  * the control domain. Means G4 processor domain needs to grant access before
- * Linux is booted. 
+ * Linux is booted.
  *
  * Copyright (C) 2021 Renesas Electronics Corp.
  */
@@ -141,17 +141,17 @@
 	};
 };
 
-&gpio3 {
+&gpio6 {
 	sel-can-sent {
 		gpio-hog;
-		gpios = <6 GPIO_ACTIVE_HIGH>;
+		gpios = <21 GPIO_ACTIVE_HIGH>;
 		output-low;
 		line-name = "SEL-CAN-SENT";
 	};
 
 	sel-can-flxray {
 		gpio-hog;
-		gpios = <14 GPIO_ACTIVE_HIGH>;
+		gpios = <22 GPIO_ACTIVE_HIGH>;
 		output-low;
 		line-name = "SEL-CAN-FLXRAY";
 	};
-- 
