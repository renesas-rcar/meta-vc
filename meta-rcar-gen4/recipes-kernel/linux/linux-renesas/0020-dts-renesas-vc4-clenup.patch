 / {
-	model = "Renesas VC4 vehicle computer board based on R-Car S4 (r8a779f0)";
-	compatible = "renesas,vc4-cpu", "renesas,r8a779f0";
+	model = "Renesas VC4 board based on r8a779f0";
+	compatible = "renesas,vc4", "renesas,r8a779f0";
 
 	aliases {
+		serial0 = &scif3;
