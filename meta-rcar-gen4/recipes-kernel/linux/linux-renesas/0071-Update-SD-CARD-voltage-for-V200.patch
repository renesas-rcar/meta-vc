 .../renesas/r8a779f0-vc4-ctrl-domainV1.dts    | 244 +++++++++++++
 arch/arm64/boot/dts/renesas/r8a779f0-vc4.dts  |  14 +-
 .../arm64/boot/dts/renesas/r8a779f0-vc4V1.dts | 344 ++++++++++++++++++
 4 files changed, 603 insertions(+), 1 deletion(-)
 create mode 100644 arch/arm64/boot/dts/renesas/r8a779f0-vc4-ctrl-domainV1.dts
