From 257789cc78a9431bb42acedd34b72ad3509e5e57 Mon Sep 17 00:00:00 2001
From: Dennis Ostermann <dennis.ostermann@renesass.com>
Date: Tue, 3 Jan 2023 15:00:26 +0100
Subject: [PATCH] Fix usage of rtsn_ptp driver in RSwitch / Rswitch2 driver

---
 drivers/net/ethernet/renesas/Makefile          |  6 +++++-
 drivers/net/ethernet/renesas/rswitch2/Makefile | 16 ++++++++--------
 2 files changed, 13 insertions(+), 9 deletions(-)

diff --git a/drivers/net/ethernet/renesas/Makefile b/drivers/net/ethernet/renesas/Makefile
index 88343d40f119..bd86dc435dca 100644
--- a/drivers/net/ethernet/renesas/Makefile
+++ b/drivers/net/ethernet/renesas/Makefile
@@ -9,7 +9,11 @@ ravb-objs := ravb_main.o ravb_ptp.o
 
 obj-$(CONFIG_RAVB) += ravb.o
 
-obj-$(CONFIG_RENESAS_ETHER_SWITCH) += rswitch.o
+
+rswitch_drv-objs := rswitch.o rtsn_ptp.o
+
+obj-$(CONFIG_RENESAS_ETHER_SWITCH) += rswitch_drv.o
+
 
 rtsn_drv-objs := rtsn.o rtsn_ptp.o
 
diff --git a/drivers/net/ethernet/renesas/rswitch2/Makefile b/drivers/net/ethernet/renesas/rswitch2/Makefile
index a49d1da7b767..e5216debef36 100644
--- a/drivers/net/ethernet/renesas/rswitch2/Makefile
+++ b/drivers/net/ethernet/renesas/rswitch2/Makefile
@@ -7,25 +7,25 @@
 #  Build Options
 #
 
-obj-$(CONFIG_RENESAS_RSWITCH2) += rswitch2.o
+rswitch2-objs := rswitch2_main.o
 
 ifneq ($(CONFIG_RENESAS_RSWITCH2_PCI), )
-	rswitch2-y += rswitch2_pci.o
+	rswitch2-objs += rswitch2_pci.o
 
 ifneq ($(CONFIG_RENESAS_RSWITCH2_PCI_FW), )
-	rswitch2-y += rswitch2_pci_fw.o
+	rswitch2-objs += rswitch2_pci_fw.o
 endif
 endif
 ifneq ($(CONFIG_RENESAS_RSWITCH2_PLATF), )
-	rswitch2-y += rswitch2_platf.o
+	rswitch2--objs += rswitch2_platf.o
 endif
 
-rswitch2-y += rswitch2_main.o
 ifneq ($(CONFIG_RENESAS_RSWITCH2_GWCA), )
-	rswitch2-y += rswitch2_eth.o
+	rswitch2-objs += rswitch2_eth.o
 endif
 
-rswitch2-y += rswitch2_fwd.o
-rswitch2-y += ../rtsn_ptp.o
+rswitch2-objs += rswitch2_fwd.o
+rswitch2-objs += ../rtsn_ptp.o
 
+obj-$(CONFIG_RENESAS_RSWITCH2) += rswitch2.o
 
-- 
2.17.1

