-static int rswitch2_serdes_reg_wait(void __iomem *addr, u32 offs, u32 bank, u32 mask, u32 expected)
-{
-	int i;
-
-	iowrite32(bank, addr + RSWITCH_SERDES_BANK_SELECT);
-	udelay(100);
