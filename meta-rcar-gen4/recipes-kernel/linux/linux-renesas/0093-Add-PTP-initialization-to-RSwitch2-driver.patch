From b18ec2c6e19854afbc62e600338156ffa36f6976 Mon Sep 17 00:00:00 2001
From: Dennis Ostermann <dennis.ostermann@renesass.com>
Date: Thu, 8 Sep 2022 09:56:27 +0200
Subject: [PATCH 093/151] Add PTP initialization to RSwitch2 driver

---
 .../net/ethernet/renesas/rswitch2/rswitch2.h  |  2 ++
 .../ethernet/renesas/rswitch2/rswitch2_main.c | 23 +++++++++++++++++--
 2 files changed, 23 insertions(+), 2 deletions(-)

diff --git a/drivers/net/ethernet/renesas/rswitch2/rswitch2.h b/drivers/net/ethernet/renesas/rswitch2/rswitch2.h
index 3c6a5523e66a..cca11cd3ffe8 100644
--- a/drivers/net/ethernet/renesas/rswitch2/rswitch2.h
+++ b/drivers/net/ethernet/renesas/rswitch2/rswitch2.h
@@ -51,6 +51,7 @@ struct rswitch2_drv {
 	void __iomem **etha_base_addrs;
 	void __iomem **gwca_base_addrs;
 	void __iomem *serdes_base_addr;
+	void __iomem *ptp_base_addr;
 	struct device *dev;
 	u32 num_of_cpu_ports;
 	u32 num_of_tsn_ports;
@@ -61,6 +62,7 @@ struct rswitch2_drv {
 	dma_addr_t bat_dma_addr;
 	struct rswitch2_port_data *port_data;
 	int irq;
+	struct rtsn_ptp_private *ptp_drv;
 	int msg_enable;
 };
 
diff --git a/drivers/net/ethernet/renesas/rswitch2/rswitch2_main.c b/drivers/net/ethernet/renesas/rswitch2/rswitch2_main.c
index b4caf6e81d76..aeea839a9fc8 100644
--- a/drivers/net/ethernet/renesas/rswitch2/rswitch2_main.c
+++ b/drivers/net/ethernet/renesas/rswitch2/rswitch2_main.c
@@ -9,6 +9,7 @@
 #include <linux/kernel.h>
 #include <linux/io.h>
 
+#include "../rtsn_ptp.h"
 #include "rswitch2_fwd.h"
 #include "rswitch2_eth.h"
 #include "rswitch2_coma.h"
@@ -80,18 +81,34 @@ int rswitch2_init(struct rswitch2_drv *rsw2)
 	rswitch2_reset(rsw2);
 
 	ret = rswitch2_init_buffer_pool(rsw2);
-	if (ret > 0)
+	if (ret < 0)
 		return ret;
 
 	rswitch2_clock_enable(rsw2);
 
+	rsw2->ptp_drv = rtsn_ptp_alloc(rsw2->dev);
+	if (!rsw2->ptp_drv) {
+		pr_err("Failed to allocate PTP driver struct\n");
+		goto err_ptp_init;
+	}
+	rsw2->ptp_drv->addr = rsw2->ptp_base_addr;
+
+	ret = rtsn_ptp_init(rsw2->ptp_drv, RTSN_PTP_REG_LAYOUT_S4, RTSN_PTP_CLOCK_S4);
+	if(ret != 0) {
+		pr_err("Failed to initialize PTP clock: %d\n", ret);
+		goto err_ptp_init;
+	}
+
+	pr_info("PTP clock initialized\n");
+
+
 	ret = rswitch2_fwd_init(rsw2);
 	if (ret < 0)
 		goto err_fwd_init;
 
 	ret = rswitch2_eth_init(rsw2);
 	if (ret < 0) {
-		pr_info("Failed to init ethernet driver: %d\n", ret);
+		pr_err("Failed to init ethernet driver: %d\n", ret);
 		goto err_eth_init;
 	}
 
@@ -100,6 +117,8 @@ int rswitch2_init(struct rswitch2_drv *rsw2)
 err_eth_init:
 	rswitch2_fwd_exit(rsw2);
 err_fwd_init:
+	kfree(rsw2->ptp_drv);
+err_ptp_init:
 	rswitch2_clock_disable(rsw2);
 	rswitch2_reset(rsw2);
 
-- 
2.17.1

