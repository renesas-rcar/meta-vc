+/* Allocate descriptor base address table */
+static int rswitch2_bat_init(struct rswitch2_drv *rsw2)
+{
+	int ret;
+	struct rswitch2_dma_desc *bat_entry;
+	size_t bat_size;
+	int i;
+
+	bat_size = sizeof(*bat_entry) * NUM_ALL_QUEUES;
+
+	rsw2->bat_addr = kzalloc(sizeof(*rsw2->bat_addr) * NUM_ALL_QUEUES, GFP_KERNEL);
+	if (!rsw2->bat_addr) {
+		ret = -ENOMEM;
+		goto bat_ptr_alloc_err;
+
+	}
+	bat_entry = dma_alloc_coherent(rsw2->dev, bat_size, &rsw2->bat_dma_addr, GFP_KERNEL);
+	if (!bat_entry) {
+		ret = -ENOMEM;
+		goto dma_alloc_err;
+	}
+
+	for (i = 0; i < NUM_ALL_QUEUES; i++) {
+		bat_entry[i].die_dt = FIELD_PREP(RSW2_DESC_DT, DT_EOS);
+		rsw2->bat_addr[i] = &bat_entry[i];
+	}
+
+	iowrite32(0, rsw2->gwca_base_addrs[0] + RSW2_GCWA_GWDCBAC0);
+	iowrite32(rsw2->bat_dma_addr, rsw2->gwca_base_addrs[0] + RSW2_GCWA_GWDCBAC1);
+
+	return 0;
+
+dma_alloc_err:
+	kfree(rsw2->bat_addr);
+
+bat_ptr_alloc_err:
+
+	return ret;
+}
+
+static int rswitch2_rx_ring_format(struct net_device *ndev, int q)
+{
+	struct rswitch2_drv *rsw2;
+	struct rswitch2_eth_port *eth_port;
+	struct rswitch2_internal_port *intern_port;
+	struct rswitch2_dma_ext_desc *rx_desc;
+	struct rswitch2_dma_desc *bat_entry;
+	int ring_size;
+	int i;
+	dma_addr_t dma_addr;
+	u32 reg_queue;
+	u32 bit_queue;
+	u32 reg_val;
+
+	eth_port = netdev_priv(ndev);
+	intern_port = eth_port->intern_port;
+
+	/* Only internal ports have DMA rings to manage */
+	BUG_ON(intern_port == NULL);
+	rsw2 = eth_port->rsw2;
+
+	intern_port->dirty_rx[q] = 0;
+	intern_port->cur_rx[q] = 0;
+	ring_size = sizeof(*rx_desc) * intern_port->rx_ring_size[q];
+
+	memset(intern_port->rx_ring[q], 0, ring_size);
+	for (i = 0, rx_desc = intern_port->rx_ring[q]; i < intern_port->rx_ring_size[q];
+			i++, rx_desc++) {
+
+		rx_desc->info_ds = cpu_to_le16(RSW2_PKT_BUF_SZ);
+
+		dma_addr = dma_map_single(rsw2->dev,
+					  (void *)intern_port->rx_skb[q][i]->data,
+					  RSW2_PKT_BUF_SZ, DMA_FROM_DEVICE);
+
+		/* We just set the data size to 0 for a failed mapping which
+		 * should prevent DMA from happening...
+		 */
+		if (dma_mapping_error(rsw2->dev, dma_addr)) {
+			dev_err(rsw2->dev, "Descriptor mapping error\n");
+			rx_desc->info_ds = cpu_to_le16(0);
+
+			return -ENOMEM;
+		}
+		rx_desc->dptrl = cpu_to_le32(dma_addr);
+		rx_desc->die_dt = FIELD_PREP(RSW2_DESC_DT, DT_FEMPTY) | RSW2_DESC_DIE;
+	}
+	/* Close the loop */
+	rx_desc->dptrl = cpu_to_le32((u32)intern_port->rx_desc_dma[q]);
+	rx_desc->die_dt = FIELD_PREP(RSW2_DESC_DT, DT_LINKFIX); /* type */
+
+	bat_entry = rsw2->bat_addr[q];
+	bat_entry->die_dt = FIELD_PREP(RSW2_DESC_DT, DT_LINKFIX); /* type */
+	bat_entry->dptrl = cpu_to_le32((u32)intern_port->rx_desc_dma[q]);
+
+	reg_val = FIELD_PREP(GWDCC_BALR, 1); /* Base address load request */
+	reg_val |= FIELD_PREP(GWDCC_DCP, 1); /* Chain priority */
+	reg_val |= FIELD_PREP(GWDCC_EDE, 1); /* Extended Descriptor Enable */
+	iowrite32(reg_val, rsw2->gwca_base_addrs[0] + RSW2_GCWA_GWDCC(RX_BAT_START));
+
+	/* Activate RX interrupt for this q */
+	reg_queue = q / RSWITCH2_BITS_PER_REG;
+	bit_queue = q % RSWITCH2_BITS_PER_REG;
+
+	reg_val = GWDIE_DIE(bit_queue);
+	iowrite32(reg_val, rsw2->gwca_base_addrs[0] + RSW2_GCWA_GWDIE(reg_queue));
+
+	return 0;
+}
+
+static int rswitch2_rx_ring_init(struct net_device *ndev, int q)
+{
+	struct rswitch2_eth_port *eth_port;
+	struct rswitch2_internal_port *intern_port;
+	struct rswitch2_drv *rsw2;
+	struct sk_buff *skb;
+	int ring_size;
+	int i;
+
+	eth_port = netdev_priv(ndev);
+	intern_port = eth_port->intern_port;
+
+	/* Only internal ports have DMA rings to manage */
+	BUG_ON(intern_port == NULL);
+	rsw2 = eth_port->rsw2;
+
+	intern_port->rx_skb[q] = kcalloc(intern_port->tx_ring_size[q],
+									sizeof(*intern_port->rx_skb[q]), GFP_KERNEL);
+	if (!intern_port->rx_skb[q])
+		goto skb_ptr_alloc_err;
+
+	for (i = 0; i < intern_port->tx_ring_size[q]; i++) {
+		skb = dev_alloc_skb(RSW2_PKT_BUF_SZ + RSW2_BUF_ALIGN - 1);
+		if (!skb)
+			goto skb_alloc_err;
+
+		skb_reserve(skb, NET_IP_ALIGN);
+		intern_port->rx_skb[q][i] = skb;
+	}
+
+	ring_size = sizeof(struct rswitch2_dma_ext_desc) * (intern_port->rx_ring_size[q] + 1);
+	intern_port->rx_ring[q] = dma_alloc_coherent(rsw2->dev, ring_size,
+					     &intern_port->rx_desc_dma[q], GFP_KERNEL);
+	if (!intern_port->rx_ring[q])
+		goto dma_alloc_err;
+
+	intern_port->dirty_rx[q] = 0;
+
+	return 0;
+
+dma_alloc_err:
+	while (--i < 0)
+		dev_kfree_skb(intern_port->rx_skb[q][i]);
+skb_alloc_err:
+	kfree(intern_port->rx_skb[q]);
+skb_ptr_alloc_err:
+
+	return -ENOMEM;
+}
+
+
+static int rswitch2_tx_ring_init(struct net_device *ndev, int q)
+{
+	struct rswitch2_eth_port *eth_port;
+	struct rswitch2_internal_port *intern_port;
+	struct rswitch2_drv *rsw2;
+	int ring_size;
+
+	eth_port = netdev_priv(ndev);
+	intern_port = eth_port->intern_port;
+
+	/* Only internal ports have DMA rings to manage */
+	BUG_ON(intern_port == NULL);
+	rsw2 = eth_port->rsw2;
+
+	/* Allocate ptr to sk_bufs */
+	intern_port->tx_skb[q] = kcalloc(intern_port->tx_ring_size[q],
+				  sizeof(*intern_port->tx_skb[q]), GFP_KERNEL);
+	if (!intern_port->tx_skb[q])
+		goto tx_skb_err;
+
+	/* Allocate all TX descriptors plus 1 to point back */
+	ring_size = sizeof(struct rswitch2_dma_ext_desc) * (intern_port->tx_ring_size[q] + 1);
+
+	intern_port->tx_ring[q] = dma_alloc_coherent(rsw2->dev,
+					      ring_size, &intern_port->tx_desc_dma[q], GFP_KERNEL);
+	if (!intern_port->tx_ring[q])
+		goto tx_ring_err;
+
+	intern_port->cur_tx[q] = 0;
+
+	return 0;
+
+tx_ring_err:
+	kfree(intern_port->tx_skb[q]);
+tx_skb_err:
+	return -ENOMEM;
+}
+
+static int rswitch2_tx_ring_format(struct net_device *ndev, int q)
+{
+	struct rswitch2_eth_port *eth_port;
+	struct rswitch2_internal_port *intern_port;
+	struct rswitch2_drv *rsw2;
+	struct rswitch2_dma_ext_desc *tx_desc;
+	struct rswitch2_dma_desc *bat_entry;
+	u32 reg_val;
+	int ring_size;
+	int i;
+
+	eth_port = netdev_priv(ndev);
+	intern_port = eth_port->intern_port;
+
+	/* Only internal ports have DMA rings to manage */
+	BUG_ON(intern_port == NULL);
+	rsw2 = eth_port->rsw2;
+
+	ring_size = sizeof(*tx_desc) * (intern_port->tx_ring_size[q] + 1);
+
+	intern_port->cur_tx[q] = 0;
+	intern_port->dirty_tx[q] = 0;
+	memset(intern_port->tx_ring[q], 0, ring_size);
+
+	/* Build TX ring buffer */
+	for (i = 0, tx_desc = intern_port->tx_ring[q]; i < intern_port->tx_ring_size[q];
+	     i++, tx_desc++) {
+		tx_desc->die_dt = FIELD_PREP(RSW2_DESC_DT, DT_EEMPTY);
+	}
+	/* Close the loop */
+	tx_desc->dptrl = cpu_to_le32((u32)intern_port->tx_desc_dma[q]);
+	tx_desc->die_dt = FIELD_PREP(RSW2_DESC_DT, DT_LINKFIX); /* type */
+
+	bat_entry = rsw2->bat_addr[intern_port->tx_bat_entry[q]];
+	bat_entry->die_dt = FIELD_PREP(RSW2_DESC_DT, DT_LINKFIX); /* type */
+	bat_entry->dptrl = cpu_to_le32((u32)intern_port->tx_desc_dma[q]);
+
+	reg_val = FIELD_PREP(GWDCC_BALR, 1); /* Base address load request */
+	reg_val |= FIELD_PREP(GWDCC_DCP, 1); /* Chain priority */
+	reg_val |= FIELD_PREP(GWDCC_DQT, 1); /* Transmission queue */
+	reg_val |= FIELD_PREP(GWDCC_EDE, 1); /* Extended Descriptor Enable */
+
+	iowrite32(reg_val, rsw2->gwca_base_addrs[0] + RSW2_GCWA_GWDCC(q + TX_QUEUE_OFFSET));
+
+	return 0;
+}
