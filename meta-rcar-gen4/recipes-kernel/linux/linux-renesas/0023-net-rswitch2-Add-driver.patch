+static irqreturn_t rswitch2_eth_interrupt(int irq, void *dev_id)
+{
+	struct rswitch2_eth_port *eth_port;
+	struct rswitch2_internal_port *intern_port;
+	struct rswitch2_drv *rsw2 = dev_id;
+	irqreturn_t ret = IRQ_HANDLED;
+	u32 reg_val;
+	u32 reg_num;
+	u32 reg_queue;
+	u32 cur_queue;
+
+	eth_port = rsw2->ports[0];
+	intern_port = eth_port->intern_port;
+
+	/* Only internal ports can TX */
+	BUG_ON(intern_port == NULL);
+	rsw2 = eth_port->rsw2;
+
+	// TODO: Move queue IRQ handling to own function
+	// Handle non-queue related IRQs
+
+	for (reg_num = 0; reg_num < RSWITCH2_CHAIN_REG_NUM; reg_num++) {
+		reg_val = ioread32(rsw2->gwca_base_addrs[0] + RSW2_GCWA_GWDIS(reg_num));
+		for (cur_queue = 0; cur_queue < RSWITCH2_BITS_PER_REG; cur_queue++) {
+			if ((BIT(cur_queue) & reg_val) == BIT(cur_queue)) {
+				if (napi_schedule_prep(&intern_port->napi[cur_queue])) {
+
+					/* Mask RX interrupts */
+					iowrite32(BIT(cur_queue), rsw2->gwca_base_addrs[0] + RSW2_GCWA_GWDID(reg_queue));
+
+					__napi_schedule(&intern_port->napi[reg_queue + cur_queue]);
+				}
+			}
+		}
+	}
+
+	return ret;
+}
