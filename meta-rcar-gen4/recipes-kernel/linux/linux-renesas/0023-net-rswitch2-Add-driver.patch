+#define RSW2_ETHA_EADQOECN		0x040C /* Ethernet Agent Descriptor Queue Overflow Error CouNter */
+#define RSW2_ETHA_EADQOECNE		0x048C /* Ethernet Agent Descriptor Queue Overflow Error CouNter Emu */
