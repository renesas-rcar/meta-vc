+
+static int rswitch2_poll(struct napi_struct *napi, int budget)
+{
+	struct net_device *ndev = napi->dev;
+
+	struct rswitch2_drv *rsw2;
+	struct rswitch2_eth_port *eth_port;
+	struct rswitch2_internal_port *intern_port;
+	unsigned long flags;
+	int q;
+	u32 reg_queue;
+	u32 bit_queue;
+	int quota = budget;
+
+	eth_port = netdev_priv(ndev);
+	intern_port = eth_port->intern_port;
+
+	/* Only internal ports can transceive */
+	BUG_ON(intern_port == NULL);
+	rsw2 = eth_port->rsw2;
+
+	q = napi - intern_port->napi;
+
+	reg_queue = q / 32;
+	bit_queue = q % 32;
+
+	/* Clear RX interrupt */
+	iowrite32(BIT(bit_queue), rsw2->gwca_base_addrs[0] + RSW2_GCWA_GWDIS(reg_queue));
+
+	if (!rswitch2_rx(ndev, &quota, q)) {
+		napi_complete(napi);
+
+		/* Re-enable RX interrupts*/
+		spin_lock_irqsave(&eth_port->lock, flags);
+		iowrite32(BIT(bit_queue), rsw2->gwca_base_addrs[0] + RSW2_GCWA_GWDIE(reg_queue));
+		spin_unlock_irqrestore(&eth_port->lock, flags);
+	}
+
+	return budget;
+}
+
+
+static int rswitch2_tx_free(struct net_device *ndev, int q)
+{
+	struct rswitch2_eth_port *eth_port;
+	struct rswitch2_internal_port *intern_port;
+
+	struct rswitch2_dma_ext_desc *tx_desc;
+	int free_num = 0;
+	int entry;
+	u32 data_ptr = 0;
+	unsigned int data_len = 0;
+
+
+	eth_port = netdev_priv(ndev);
+	intern_port = eth_port->intern_port;
+
+	//struct net_device_stats *stats = &priv->stats[q];
+
+	while (intern_port->cur_tx[q] - intern_port->dirty_tx[q] > 0) {
+		entry = intern_port->dirty_tx[q] % intern_port->tx_ring_size[q];
+		tx_desc = &intern_port->tx_ring[q][entry];
+
+		if (FIELD_GET(RSW2_DESC_DT, tx_desc->die_dt) != DT_FEMPTY)
+			break;
+
+		/* Descriptor type must be checked before all other reads */
+		dma_rmb();
+		data_len += FIELD_GET(RSW2_DESC_DS, le16_to_cpu(tx_desc->info_ds));
+
+		if (!data_ptr)
+			data_ptr = le32_to_cpu(tx_desc->dptrl);
+
+		/* Free the original skb */
+		if (intern_port->tx_skb[q][entry]) {
+			dma_unmap_single(ndev->dev.parent, data_ptr, data_len, DMA_TO_DEVICE);
+
+			dev_kfree_skb_any(intern_port->tx_skb[q][entry]);
+			intern_port->tx_skb[q][entry] = NULL;
+			data_ptr = 0;
+			/* TODO: stats */
+			//stats->tx_packets++;
+			free_num++;
+		} else {
+			netdev_dbg(ndev, "Entry: %d Sum up length of multi frame: len=%u\n",
+						entry, data_len);
+			free_num++;
+		}
+		/* TODO: update stats */
+		//	stats->tx_bytes += size;
+
+		tx_desc->die_dt = FIELD_PREP(RSW2_DESC_DT, DT_EEMPTY);
+		intern_port->dirty_tx[q]++;
+	}
+
+	return free_num;
+}
