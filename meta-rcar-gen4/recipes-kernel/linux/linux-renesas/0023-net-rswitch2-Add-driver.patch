+static void rswitch2_init_mac_addr(struct net_device *ndev)
+{
+	struct rswitch2_drv *rsw2;
+	struct rswitch2_eth_port *eth_port;
+
+	eth_port = netdev_priv(ndev);
+	rsw2 = eth_port->rsw2;
+
+	dev_info(rsw2->dev, "%s:%d: Port: %d\n", __FUNCTION__, __LINE__, eth_port->port_num);
+
+	if (!eth_platform_get_mac_address(&ndev->dev, ndev->dev_addr)) {
+		if (is_valid_ether_addr(ndev->dev_addr)) {
+			/* device tree values are valid so use them */
+			return;
+		}
+		dev_info(rsw2->dev, "%s:%d: No platform MAC address\n", __FUNCTION__, __LINE__);
+
+	} else {
+		struct rswitch2_port_data *port_data;
+
+		dev_info(rsw2->dev, "%s:%d: Using static port data\n", __FUNCTION__, __LINE__);
+
+
+		port_data = &rsw2->port_data[eth_port->port_num];
+
+		/* Use MAC address from port_data */
+		memcpy(ndev->dev_addr, port_data->mac_addr, ndev->addr_len);
+		netdev_info(ndev, "Assigned MAC %.2X:%.2X:%.2X:%.2X:%.2X:%.2X to '%s'\n",
+				port_data->mac_addr[0], port_data->mac_addr[1],
+				port_data->mac_addr[2], port_data->mac_addr[3],
+				port_data->mac_addr[4], port_data->mac_addr[5],
+				ndev->name);
+	}
+}
