+/*
+static MRVL_APHY_STATUS MRVL_AMG_GetFirmwareInfo(MRVL_DEV_PTR device, MRVL_AMG_FirmwareInfo* fwInfo)
+{
+	MRVL_APHY_U32 regData = 0;
