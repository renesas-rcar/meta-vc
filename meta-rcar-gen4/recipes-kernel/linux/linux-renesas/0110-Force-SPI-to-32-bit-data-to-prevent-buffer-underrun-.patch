From 75a7312d3a3206748bcc19dcedc1cb8ce68e49e4 Mon Sep 17 00:00:00 2001
From: "Christian@p620" <Christian@p620>
Date: Mon, 26 Sep 2022 17:52:27 +0200
Subject: [PATCH 110/151] Force SPI to 32 bit data to prevent buffer underrun
 in LAN8650 @ 10 MHz SPI clock

---
 drivers/net/ethernet/microchip/lan865x/lan865x.c | 11 ++++++-----
 1 file changed, 6 insertions(+), 5 deletions(-)

diff --git a/drivers/net/ethernet/microchip/lan865x/lan865x.c b/drivers/net/ethernet/microchip/lan865x/lan865x.c
index 109612c292e4..f8d76dca186a 100644
--- a/drivers/net/ethernet/microchip/lan865x/lan865x.c
+++ b/drivers/net/ethernet/microchip/lan865x/lan865x.c
@@ -193,7 +193,7 @@ void TC6Stub_Print(uint8_t idx, void *pGlobalTag, const char *statement, ... )
 void TC6_CB_OnRxEthernetSlice(TC6_t *pInst, const uint8_t *pRx, uint16_t offset, uint16_t len, void *pGlobalTag)
 {
 	struct lan865x_priv *priv = pGlobalTag;
-	
+
 	if (priv->Eth_RxInvalid)
 	{
 		dev_err(&priv->spi->dev, "on_rx_slice: ignoring invalid marked. offset: %d\n\r", offset);
@@ -277,7 +277,7 @@ void TC6_CB_OnRxEthernetPacket(TC6_t *pInst, bool success, uint16_t len, void *p
 void TC6_CB_OnError(TC6_t *pInst, TC6_Error_t err, void *pGlobalTag)
 {
 	struct lan865x_priv *priv = pGlobalTag;
-	
+
 	dev_err(&priv->spi->dev, "tc6 err = %x\n", err);
 }
 
@@ -603,7 +603,7 @@ static void lan865x_set_multicast_list(struct net_device *netdev)
 	u32 regVal = 0;
 
 	if (netdev->flags & IFF_PROMISC) {
-		/* Enabling promiscuous mode */	
+		/* Enabling promiscuous mode */
 		regVal |= MAC_PROMISCUOUS_MODE;
 		regVal &= (~MAC_MULTICAST_MODE);
 		regVal &= (~MAC_UNICAST_MODE);
@@ -904,10 +904,11 @@ static int lan865x_probe(struct spi_device *spi)
 		ret = -EIO;
 		goto error_set_mac;
 	}
-	
+
 	spi->rt = true;
+	spi->bits_per_word = 32;
 	spi_setup(spi);
-	pr_info("spi->irq: %d\n", spi->irq);
+	pr_info("spi->irq: %d  data_with: %d\n", spi->irq, spi->bits_per_word);
 	timer_setup(&priv->tc6_timer, timer_callback, 0);
 	mod_timer(&priv->tc6_timer, jiffies + msecs_to_jiffies(TIMEOUT));
 	ret = devm_request_threaded_irq(&spi->dev, spi->irq, NULL,
-- 
2.17.1

