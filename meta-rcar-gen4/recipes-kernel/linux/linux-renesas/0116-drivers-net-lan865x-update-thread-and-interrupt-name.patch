From d40cb6b797f7572e6942144e7922fd4319c9c57d Mon Sep 17 00:00:00 2001
From: Nikita Yushchenko <nikita.yoush@cogentembedded.com>
Date: Thu, 13 Oct 2022 09:22:37 +0600
Subject: [PATCH 116/151] drivers: net: lan865x: update thread and interrupt
 names

Instead of using constant strings, make those dependent on spi device
name. This makes it possible to match instances against devices in 'ps'
or 'cat /proc/interrupts' output.

Signed-off-by: Nikita Yushchenko <nikita.yoush@cogentembedded.com>
---
 drivers/net/ethernet/microchip/lan865x/lan865x.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/drivers/net/ethernet/microchip/lan865x/lan865x.c b/drivers/net/ethernet/microchip/lan865x/lan865x.c
index f124799b9b70..65b5957486aa 100644
--- a/drivers/net/ethernet/microchip/lan865x/lan865x.c
+++ b/drivers/net/ethernet/microchip/lan865x/lan865x.c
@@ -877,7 +877,8 @@ static int lan865x_probe(struct spi_device *spi)
 		goto error_platform_data;
 	}
 
-	priv->tc6_task = kthread_run(tc6_handler, priv, "tc6_task");
+	priv->tc6_task = kthread_run(tc6_handler, priv, "tc6_task %s",
+				     dev_name(&spi->dev));
 	if (IS_ERR(priv->tc6_task)) {
 		ret = PTR_ERR(priv->tc6_task);
 		goto error_tc6_task;
@@ -912,8 +913,8 @@ static int lan865x_probe(struct spi_device *spi)
 	timer_setup(&priv->tc6_timer, timer_callback, 0);
 	mod_timer(&priv->tc6_timer, jiffies + msecs_to_jiffies(TIMEOUT));
 	ret = devm_request_threaded_irq(&spi->dev, spi->irq, NULL,
-					lan865x_irq,
-					IRQF_ONESHOT, "tc6 int", priv);
+					lan865x_irq, IRQF_ONESHOT,
+					dev_name(&spi->dev), priv);
 	if (ret < 0) {
 		dev_err(&spi->dev, "error attaching irq %d\n", ret);
 		goto error_irq;
-- 
