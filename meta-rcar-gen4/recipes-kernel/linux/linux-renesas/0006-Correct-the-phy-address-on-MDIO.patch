From 1adf1f9c8a02bca74f84924d680d4567ed58d2b0 Mon Sep 17 00:00:00 2001
From: "Christian@p620" <Christian@p620>
Date: Tue, 11 Jan 2022 19:08:09 +0100
Subject: [PATCH 006/151] Correct the phy address on MDIO

---
 arch/arm64/boot/dts/renesas/r8a779f0-vc4.dts | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/arch/arm64/boot/dts/renesas/r8a779f0-vc4.dts b/arch/arm64/boot/dts/renesas/r8a779f0-vc4.dts
index e7b7bcc966db..9bfbe97baae3 100644
--- a/arch/arm64/boot/dts/renesas/r8a779f0-vc4.dts
+++ b/arch/arm64/boot/dts/renesas/r8a779f0-vc4.dts
@@ -71,7 +71,7 @@
 			#address-cells = <1>;
 			#size-cells = <0>;
 			etha0: ethernet-phy@0 {
-				reg = <1>;
+				reg = <3>;
 				compatible = "ethernet-phy-ieee802.3-c45";
 			};
 		};
@@ -81,7 +81,7 @@
 			#address-cells = <1>;
 			#size-cells = <0>;
 			etha1: ethernet-phy@1 {
-				reg = <2>;
+				reg = <3>;
 				compatible = "ethernet-phy-ieee802.3-c45";
 			};
 		};
-- 
