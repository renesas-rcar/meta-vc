 	u32 rx_over_errors;
 	u32 rx_fifo_errors;
 	struct sk_buff **rx_skb[NUM_RX_QUEUES];
@@ -193,6 +206,7 @@ struct rswitch2_eth_port {
 	struct net_device *ndev;
 	struct rswitch2_drv *rsw2;
 	struct net_device_stats stats[NUM_RX_QUEUES];
+	struct timer_list stat_timer;
 	spinlock_t lock;
 
 
