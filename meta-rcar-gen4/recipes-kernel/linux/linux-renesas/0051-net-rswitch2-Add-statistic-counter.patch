+
 };
 
 struct rswitch2_internal_port {
@@ -181,6 +190,10 @@ struct rswitch2_internal_port {
 	u32 dirty_rx[NUM_RX_QUEUES];	/* Producer ring indices */
 	u32 cur_tx[NUM_TX_QUEUES];
