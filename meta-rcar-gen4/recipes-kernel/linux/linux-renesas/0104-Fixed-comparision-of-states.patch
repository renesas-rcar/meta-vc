From 8880e0fd2db42bb4eb389c40a58b477fdbf76e7b Mon Sep 17 00:00:00 2001
From: Dennis Ostermann <dennis.ostermann@renesass.com>
Date: Fri, 23 Sep 2022 11:02:12 +0200
Subject: [PATCH 104/151] Fixed comparision of states

---
 drivers/net/ethernet/renesas/rswitch2/rswitch2_eth.c | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/drivers/net/ethernet/renesas/rswitch2/rswitch2_eth.c b/drivers/net/ethernet/renesas/rswitch2/rswitch2_eth.c
index 410b64f38b15..502911055399 100644
--- a/drivers/net/ethernet/renesas/rswitch2/rswitch2_eth.c
+++ b/drivers/net/ethernet/renesas/rswitch2/rswitch2_eth.c
@@ -43,7 +43,7 @@ static int rswitch2_gwca_set_state(struct rswitch2_drv *rsw2, enum gwmc_op state
 	iowrite32(reg_val, rsw2->gwca_base_addrs[0] + RSW2_ETHA_EAMC);
 
 	ret = readl_poll_timeout(rsw2->gwca_base_addrs[0] + RSW2_ETHA_EAMS, reg_val,
-						reg_val & FIELD_PREP(EAMS_OPS, state),
+						reg_val == FIELD_PREP(EAMS_OPS, state),
 						RSWITCH2_REG_POLL_DELAY, RSWITCH2_REG_POLL_TIMEOUT);
 	if (ret != 0) {
 		dev_err(rsw2->dev, "Setting GWCA state timed out\n");
@@ -64,10 +64,10 @@ static int rswitch2_emac_set_state(struct net_device *ndev, enum emac_op state)
 	iowrite32(reg_val, etha_base_addr + RSW2_ETHA_EAMC);
 
 	ret = readl_poll_timeout(etha_base_addr + RSW2_ETHA_EAMS, reg_val,
-						reg_val & FIELD_PREP(EAMS_OPS, state),
+						(reg_val == FIELD_PREP(EAMS_OPS, state)),
 						RSWITCH2_REG_POLL_DELAY, RSWITCH2_REG_POLL_TIMEOUT);
 	if (ret != 0) {
-		netdev_err(ndev, "Setting EMAC state to %d timed out\n", reg_val);
+		netdev_err(ndev, "Setting EMAC state from %d to %d timed out\n", reg_val, state);
 		return ret;
 	}
 
-- 
