From 0168869eb1728950b195e1023310f348a9a3f2ea Mon Sep 17 00:00:00 2001
From: Dennis Ostermann <dennis.ostermann@renesass.com>
Date: Tue, 6 Dec 2022 17:22:11 +0100
Subject: [PATCH 127/151] rswitch2: Temoprary fix to use upstream PTP driver

---
 .../net/ethernet/renesas/rswitch2/rswitch2_main.c   |  2 +-
 drivers/net/ethernet/renesas/rtsn_ptp.c             | 13 +++++++++++++
 drivers/net/ethernet/renesas/rtsn_ptp.h             |  1 +
 3 files changed, 15 insertions(+), 1 deletion(-)

diff --git a/drivers/net/ethernet/renesas/rswitch2/rswitch2_main.c b/drivers/net/ethernet/renesas/rswitch2/rswitch2_main.c
index 638f09dbe8df..a37333f63ad5 100644
--- a/drivers/net/ethernet/renesas/rswitch2/rswitch2_main.c
+++ b/drivers/net/ethernet/renesas/rswitch2/rswitch2_main.c
@@ -86,7 +86,7 @@ int rswitch2_init(struct rswitch2_drv *rsw2)
 
 	rswitch2_clock_enable(rsw2);
 
-	rsw2->ptp_drv = rtsn_ptp_alloc(rsw2->dev);
+	rsw2->ptp_drv = rtsn_ptp_alloc_dev(rsw2->dev);
 	if (!rsw2->ptp_drv) {
 		rsw2_err(MSG_GEN, "Failed to allocate PTP driver struct\n");
 		goto err_ptp_init;
diff --git a/drivers/net/ethernet/renesas/rtsn_ptp.c b/drivers/net/ethernet/renesas/rtsn_ptp.c
index ea3738273a06..8b23cd421c36 100644
--- a/drivers/net/ethernet/renesas/rtsn_ptp.c
+++ b/drivers/net/ethernet/renesas/rtsn_ptp.c
@@ -176,3 +176,16 @@ struct rtsn_ptp_private *rtsn_ptp_alloc(struct platform_device *pdev)
 
 	return ptp;
 }
+
+struct rtsn_ptp_private *rtsn_ptp_alloc_dev(struct device *dev)
+{
+	struct rtsn_ptp_private *ptp;
+
+	ptp = devm_kzalloc(dev, sizeof(*ptp), GFP_KERNEL);
+	if (!ptp)
+		return NULL;
+
+	ptp->info = rtsn_ptp_info;
+
+	return ptp;
+}
diff --git a/drivers/net/ethernet/renesas/rtsn_ptp.h b/drivers/net/ethernet/renesas/rtsn_ptp.h
index fd24a1fa5958..4c3e34756487 100644
--- a/drivers/net/ethernet/renesas/rtsn_ptp.h
+++ b/drivers/net/ethernet/renesas/rtsn_ptp.h
@@ -79,5 +79,6 @@ struct rtsn_ptp_private {
 
 int rtsn_ptp_init(struct rtsn_ptp_private *ptp_priv, enum rtsn_ptp_reg_layout layout, u32 clock);
 struct rtsn_ptp_private *rtsn_ptp_alloc(struct platform_device *pdev);
+struct rtsn_ptp_private *rtsn_ptp_alloc_dev(struct device *dev);
 
 #endif
-- 
2.17.1

