From: Vito Colagiacomo <vito.colagiacomo@renesas.com>
Date: Mon, 10 Jan 2022 13:52:18 +0100
Subject: [PATCH 004/151] dts: arm64: renesas: Fix phy-handles for vc4 rswitch
 ports

---
 arch/arm64/boot/dts/renesas/r8a779f0-vc4.dts | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/arch/arm64/boot/dts/renesas/r8a779f0-vc4.dts b/arch/arm64/boot/dts/renesas/r8a779f0-vc4.dts
index 7292f2e4ad56..e7b7bcc966db 100644
--- a/arch/arm64/boot/dts/renesas/r8a779f0-vc4.dts
+++ b/arch/arm64/boot/dts/renesas/r8a779f0-vc4.dts
@@ -77,7 +77,7 @@
 		};
 		port@1 {
 			reg = <1>;
-			phy-handle = <&etha0>;
+			phy-handle = <&etha1>;
 			#address-cells = <1>;
 			#size-cells = <0>;
 			etha1: ethernet-phy@1 {
@@ -87,7 +87,7 @@
 		};
 		port@2 {
 			reg = <2>;
-			phy-handle = <&etha0>;
+			phy-handle = <&etha2>;
 			#address-cells = <1>;
 			#size-cells = <0>;
 			etha2: ethernet-phy@2 {
