From 62b42c87d3b5f1332ae288897b81dfb55445406c Mon Sep 17 00:00:00 2001
From: "Christian@p620" <Christian@p620>
Date: Tue, 16 Aug 2022 15:51:09 +0200
Subject: [PATCH 072/151] Correct speed setting and prevent SERDES reset during
 initial connect

---
 .../ethernet/renesas/rswitch2/rswitch2_eth.c  | 19 +++++++++----------
 .../ethernet/renesas/rswitch2/rswitch2_eth.h  |  3 ++-
 2 files changed, 11 insertions(+), 11 deletions(-)

diff --git a/drivers/net/ethernet/renesas/rswitch2/rswitch2_eth.c b/drivers/net/ethernet/renesas/rswitch2/rswitch2_eth.c
index b8bbfabc85c7..4188f436c798 100644
--- a/drivers/net/ethernet/renesas/rswitch2/rswitch2_eth.c
+++ b/drivers/net/ethernet/renesas/rswitch2/rswitch2_eth.c
@@ -445,7 +445,6 @@ static int rswitch2_serdes_common_setting(struct rswitch2_eth_port *eth_port)
 	for (lane = 0; lane < rsw2->num_of_tsn_ports; lane++) {
 		addr = rsw2->serdes_base_addr + (RSW2_SERDES_CHANNEL_OFFSET * lane);
 		rswitch2_serdes_write32(addr, VR_XS_PCS_SFTY_MR_CTRL, BANK_380, 0x443);
-break;
 	}
 
 	addr = rsw2->serdes_base_addr;
@@ -504,7 +503,6 @@ break;
 	for (lane = 0; lane < rsw2->num_of_tsn_ports; lane++) {
 		addr = rsw2->serdes_base_addr + (RSW2_SERDES_CHANNEL_OFFSET * lane);
 		rswitch2_serdes_write32(addr, 0x03d0, BANK_380, 1);
-break;
 	}
 	rswitch2_serdes_write32(rsw2->serdes_base_addr, VR_XS_PCS_DIG_CTRL1, BANK_380, 0x8000);
 
@@ -651,10 +649,10 @@ static int rswitch2_serdes_chan_setting(struct rswitch2_eth_port *eth_port, phy_
 	return 0;
 }
 
-static int rswitch2_serdes_set_speed(struct rswitch2_drv *rsw2, phy_interface_t phy_iface, int speed)
+static int rswitch2_serdes_set_speed(struct rswitch2_eth_port *eth_port, phy_interface_t phy_iface, int speed)
 {
 	//int ret;
-	void __iomem *addr = rsw2->serdes_base_addr;
+	void __iomem *addr = eth_port->phy_port->serdes_chan_addr;
 
 	switch (phy_iface) {
 	case PHY_INTERFACE_MODE_SGMII:
@@ -709,8 +707,9 @@ static void rswitch2_serdes_check_operation(struct timer_list *t)
 	spin_lock_irqsave(&phy_port->lock, flags);
 
 
-	if(phy_port->serdes_usxgmii_op_cnt < RSW2_SERDES_OP_RETRIES) {
-
+	if (phy_port->serdes_usxgmii_op_cnt < RSW2_SERDES_OP_RETRIES) {
+		//Link status is latched, for current status read twice
+		rswitch2_serdes_read32(phy_port->serdes_chan_addr, SR_XS_PCS_STS1, BANK_300);
 		reg_val = rswitch2_serdes_read32(phy_port->serdes_chan_addr, SR_XS_PCS_STS1, BANK_300);
 		if (reg_val & 0x04) {
 			pr_notice("SerDes USXGMII is operational on port %s %s (retries = %d)\n", phy_port->mii_bus->name, phy_port->mii_bus->id, phy_port->serdes_usxgmii_op_cnt);
@@ -730,7 +729,7 @@ static void rswitch2_serdes_check_operation(struct timer_list *t)
 		}
 	}
 	else {
-		pr_err("Could not bring SerDes USXGMII into operational state. Giving up!\n");
+		pr_err("Could not bring SerDes USXGMII on port %s %s into operational state. Giving up!\n", phy_port->mii_bus->name, phy_port->mii_bus->id);
 	}
 
 	spin_unlock_irqrestore(&phy_port->lock, flags);
@@ -754,7 +753,7 @@ static int rswitch2_serdes_init(struct net_device *ndev, unsigned int port_num)
 
 
 	/* TODO: Support more modes and speed selection */
-	printk("%s: sw0p%d  phy_mode=%d\n", __FUNCTION__, port_num, ndev->phydev->interface );
+	//printk("%s: sw0p%d  phy_mode=%d\n", __FUNCTION__, port_num, ndev->phydev->interface );
 	switch (ndev->phydev->interface) {
 	case PHY_INTERFACE_MODE_SGMII:
 		speed = 1000;
@@ -795,7 +794,7 @@ static int rswitch2_serdes_init(struct net_device *ndev, unsigned int port_num)
 	}
 
 	/* Set speed (bps) */
-	ret = rswitch2_serdes_set_speed(rsw2, ndev->phydev->interface, speed);
+	ret = rswitch2_serdes_set_speed(eth_port, ndev->phydev->interface, speed);
 	if (ret) {
 		netdev_err(ndev, "set initial SERDES speed for port %d failed\n", port_num);
 		return ret;
@@ -830,7 +829,7 @@ static int rswitch2_serdes_init(struct net_device *ndev, unsigned int port_num)
 	/* USXGMII needs deferred check to proof operation */
 	if(ndev->phydev->interface == PHY_INTERFACE_MODE_USXGMII) {
 		timer_setup(&phy_port->serdes_usxgmii_op_timer, rswitch2_serdes_check_operation, 0);
-		mod_timer(&phy_port->serdes_usxgmii_op_timer, jiffies + msecs_to_jiffies(RSW2_SERDES_OP_TIMER_INTERVALL));
+		mod_timer(&phy_port->serdes_usxgmii_op_timer, jiffies + msecs_to_jiffies(RSW2_SERDES_OP_TIMER_INTERVALL_FIRST));
 	}
 
 	return 0;
diff --git a/drivers/net/ethernet/renesas/rswitch2/rswitch2_eth.h b/drivers/net/ethernet/renesas/rswitch2/rswitch2_eth.h
index 31a9ac07e016..8850fd56d3c6 100644
--- a/drivers/net/ethernet/renesas/rswitch2/rswitch2_eth.h
+++ b/drivers/net/ethernet/renesas/rswitch2/rswitch2_eth.h
@@ -151,7 +151,8 @@ enum rsw2_info1_format {
 
 
 #define RSW2_STAT_TIMER_INTERVALL (3000)
-#define RSW2_SERDES_OP_TIMER_INTERVALL (1000)
+#define RSW2_SERDES_OP_TIMER_INTERVALL (500)
+#define RSW2_SERDES_OP_TIMER_INTERVALL_FIRST (1500)
 #define RSW2_SERDES_OP_RETRIES (5)
 
 struct rswitch2_dma_extts_desc {
-- 
2.17.1

