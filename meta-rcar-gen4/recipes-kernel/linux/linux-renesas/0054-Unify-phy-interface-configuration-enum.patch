From d4c65509135b9a46f49027553e09e73bf512ed8e Mon Sep 17 00:00:00 2001
From: "Christian@p620" <Christian@p620>
Date: Thu, 19 May 2022 18:13:14 +0200
Subject: [PATCH 054/151] Unify phy interface configuration enum

---
 .../ethernet/renesas/rswitch2/rswitch2_eth.c  | 24 ++++++++-----------
 .../renesas/rswitch2/rswitch2_serdes.h        |  6 -----
 2 files changed, 10 insertions(+), 20 deletions(-)

diff --git a/drivers/net/ethernet/renesas/rswitch2/rswitch2_eth.c b/drivers/net/ethernet/renesas/rswitch2/rswitch2_eth.c
index eca985dd5055..80470439e3d5 100644
--- a/drivers/net/ethernet/renesas/rswitch2/rswitch2_eth.c
+++ b/drivers/net/ethernet/renesas/rswitch2/rswitch2_eth.c
@@ -523,7 +523,7 @@ break;
 	return 0;
 }
 
-static int rswitch2_serdes_chan_setting(struct rswitch2_eth_port *eth_port, enum rswitch_serdes_mode mode)
+static int rswitch2_serdes_chan_setting(struct rswitch2_eth_port *eth_port, phy_interface_t phy_iface)
 {
 	void __iomem *addr;
 	struct rswitch2_physical_port *phy_port;
@@ -534,8 +534,8 @@ static int rswitch2_serdes_chan_setting(struct rswitch2_eth_port *eth_port, enum
 	addr = phy_port->serdes_chan_addr;
 
 	//printk("%s(port=%d, mode=%d)\n", __FUNCTION__, eth_port->port_num, mode);
-	switch (mode) {
-	case SGMII:
+	switch (phy_iface) {
+	case PHY_INTERFACE_MODE_SGMII:
 		rswitch2_serdes_write32(addr, VR_XS_PCS_DIG_CTRL1, BANK_380, 0x2000);
 		rswitch2_serdes_write32(addr, VR_XS_PMA_MP_12G_16G_25G_MPLL_CMN_CTRL, BANK_180, 0x11);
 		rswitch2_serdes_write32(addr, VR_XS_PMA_MP_12G_16G_25G_VCO_CAL_LD0, BANK_180, 0x540);
@@ -587,7 +587,7 @@ static int rswitch2_serdes_chan_setting(struct rswitch2_eth_port *eth_port, enum
 #endif
 		break;
 
-	case USXGMII:
+	case PHY_INTERFACE_MODE_USXGMII:
 		rswitch2_serdes_write32(addr, SR_XS_PCS_CTRL2, BANK_300, 0x0);
 		rswitch2_serdes_write32(addr, VR_XS_PCS_DEBUG_CTRL, BANK_380, 0x50);
 		rswitch2_serdes_write32(addr, VR_XS_PCS_DIG_CTRL1, BANK_380, 0x2200);
@@ -651,14 +651,13 @@ static int rswitch2_serdes_chan_setting(struct rswitch2_eth_port *eth_port, enum
 	return 0;
 }
 
-static int rswitch2_serdes_set_speed(struct rswitch2_drv *rsw2, enum rswitch_serdes_mode mode,
-				    int speed)
+static int rswitch2_serdes_set_speed(struct rswitch2_drv *rsw2, phy_interface_t phy_iface, int speed)
 {
 	//int ret;
 	void __iomem *addr = rsw2->serdes_base_addr;
 
-	switch (mode) {
-	case SGMII:
+	switch (phy_iface) {
+	case PHY_INTERFACE_MODE_SGMII:
 		if (speed == 1000)
 			rswitch2_serdes_write32(addr, SR_MII_CTRL, BANK_1F00, 0x0140);
 		else if (speed == 100)
@@ -676,7 +675,7 @@ static int rswitch2_serdes_set_speed(struct rswitch2_drv *rsw2, enum rswitch_ser
 #endif
 		break;
 
-	case USXGMII:
+	case PHY_INTERFACE_MODE_USXGMII:
 		if (speed == 2500)
 			rswitch2_serdes_write32(addr, SR_MII_CTRL, BANK_1F00, 0x120);
 		else
@@ -705,7 +704,6 @@ static int rswitch2_serdes_init(struct net_device *ndev, unsigned int port_num)
 {
 	int ret;
 	int speed;
-	enum rswitch_serdes_mode mode;
 	struct rswitch2_drv *rsw2;
 	struct rswitch2_eth_port *eth_port;
 	struct rswitch2_physical_port *phy_port;
@@ -722,12 +720,10 @@ static int rswitch2_serdes_init(struct net_device *ndev, unsigned int port_num)
 	printk("%s: sw0p%d  phy_mode=%d\n", __FUNCTION__, port_num, ndev->phydev->interface );
 	switch (ndev->phydev->interface) {
 	case PHY_INTERFACE_MODE_SGMII:
-		mode = SGMII;
 		speed = 1000;
 		netdev_info(ndev, "port %d uses SGMII at %d Mbit/s\n", port_num, speed);
 		break;
 	case PHY_INTERFACE_MODE_USXGMII:
-		mode = USXGMII;
 		speed = 2500;
 		netdev_info(ndev, "port %d uses USXGMII at %d Mbit/s\n", port_num, speed);
 
@@ -755,14 +751,14 @@ static int rswitch2_serdes_init(struct net_device *ndev, unsigned int port_num)
 
 
 	/* Set channel settings*/
-	ret = rswitch2_serdes_chan_setting(eth_port, mode);
+	ret = rswitch2_serdes_chan_setting(eth_port, ndev->phydev->interface);
 	if (ret) {
 		netdev_err(ndev, "channel specific SERDES configuration for port %d failed. ret=%d\n", port_num, ret);
 		return ret;
 	}
 
 	/* Set speed (bps) */
-	ret = rswitch2_serdes_set_speed(rsw2, mode, speed);
+	ret = rswitch2_serdes_set_speed(rsw2, ndev->phydev->interface, speed);
 	if (ret) {
 		netdev_err(ndev, "set initial SERDES speed for port %d failed\n", port_num);
 		return ret;
diff --git a/drivers/net/ethernet/renesas/rswitch2/rswitch2_serdes.h b/drivers/net/ethernet/renesas/rswitch2/rswitch2_serdes.h
index b892016036ac..50da50a44b4d 100644
--- a/drivers/net/ethernet/renesas/rswitch2/rswitch2_serdes.h
+++ b/drivers/net/ethernet/renesas/rswitch2/rswitch2_serdes.h
@@ -7,12 +7,6 @@
 
 #ifndef _RSWITCH2_SERDES_H
 #define _RSWITCH2_SERDES_H
-/* SerDes */
-enum rswitch_serdes_mode {
-	USXGMII,
-	SGMII,
-	COMBINATION,
-};
 
 #define RSW2_SERDES_CHANNEL_OFFSET              0x0400
 #define RSWITCH_SERDES_BANK_SELECT              0x03fc
-- 
2.17.1

