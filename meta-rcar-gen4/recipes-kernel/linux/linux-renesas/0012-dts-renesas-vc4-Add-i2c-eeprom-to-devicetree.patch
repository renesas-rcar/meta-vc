From 4595da365614ad072c5d03c1c3bb29afe38399d0 Mon Sep 17 00:00:00 2001
From: Vito Colagiacomo <vito.colagiacomo@renesas.com>
Date: Thu, 20 Jan 2022 15:39:08 +0100
Subject: [PATCH 012/151] dts: renesas: vc4: Add i2c eeprom to devicetree

---
 arch/arm64/boot/dts/renesas/r8a779f0-vc4-cpu.dtsi |  4 ++--
 .../boot/dts/renesas/r8a779f0-vc4-ethernet.dtsi   | 15 ---------------
 arch/arm64/boot/dts/renesas/r8a779f0-vc4.dts      | 10 ----------
 3 files changed, 2 insertions(+), 27 deletions(-)
 delete mode 100644 arch/arm64/boot/dts/renesas/r8a779f0-vc4-ethernet.dtsi

diff --git a/arch/arm64/boot/dts/renesas/r8a779f0-vc4-cpu.dtsi b/arch/arm64/boot/dts/renesas/r8a779f0-vc4-cpu.dtsi
index 618dd27c866f..7a00dfcb0c36 100644
--- a/arch/arm64/boot/dts/renesas/r8a779f0-vc4-cpu.dtsi
+++ b/arch/arm64/boot/dts/renesas/r8a779f0-vc4-cpu.dtsi
@@ -108,8 +108,8 @@
 	clock-frequency = <400000>;
 
 	eeprom@50 {
-		compatible = "rohm,br24g01", "atmel,24c01";
-		label = "cpu-board";
+		compatible = "st,24c16", "atmel,24c16";
+		label = "board-data";
 		reg = <0x50>;
 		pagesize = <8>;
 	};
diff --git a/arch/arm64/boot/dts/renesas/r8a779f0-vc4-ethernet.dtsi b/arch/arm64/boot/dts/renesas/r8a779f0-vc4-ethernet.dtsi
deleted file mode 100644
index 15e8d1ebf575..000000000000
--- a/arch/arm64/boot/dts/renesas/r8a779f0-vc4-ethernet.dtsi
+++ /dev/null
@@ -1,15 +0,0 @@
-// SPDX-License-Identifier: GPL-2.0
-/*
- * Device Tree Source for the Spider Ethernet sub-board
- *
- * Copyright (C) 2021 Renesas Electronics Corp.
- */
-
-&i2c4 {
-	eeprom@52 {
-		compatible = "rohm,br24g01", "atmel,24c01";
-		label = "ethernet-sub-board";
-		reg = <0x52>;
-		pagesize = <8>;
-	};
-};
diff --git a/arch/arm64/boot/dts/renesas/r8a779f0-vc4.dts b/arch/arm64/boot/dts/renesas/r8a779f0-vc4.dts
index 36b7fd1961bf..95562d5d6d9d 100644
--- a/arch/arm64/boot/dts/renesas/r8a779f0-vc4.dts
+++ b/arch/arm64/boot/dts/renesas/r8a779f0-vc4.dts
@@ -7,7 +7,6 @@
 
 /dts-v1/;
 #include "r8a779f0-vc4-cpu.dtsi"
-#include "r8a779f0-vc4-ethernet.dtsi"
 
 / {
 	model = "Renesas VC4 vehicle computer board based on R-Car S4 (r8a779f0)";
@@ -18,15 +17,6 @@
 		};
 };
 
-&i2c4 {
-	eeprom@51 {
-		compatible = "rohm,br24g01", "atmel,24c01";
-		label = "breakout-board";
-		reg = <0x51>;
-		pagesize = <8>;
-	};
-};
-
 &pfc {
 	tsn0_pins: tsn0 {
 		mux {
