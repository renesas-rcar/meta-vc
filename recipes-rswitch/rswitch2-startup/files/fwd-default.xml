<?xml version="1.0"?>
<R-SWITCH2>
    <CLOCK-MHZ>80</CLOCK-MHZ>
    <Forwarding>
        <General-Configuration>
            <VLAN-Mode>CTAG</VLAN-Mode>
            <TPID>33024</TPID>
            
            <Port-Specific>
                <PortNumber>tsn4</PortNumber> <!-- CPU & PortNumber mutually exclusive -->
                <VLAN-Reject-Unknown-Secure>Disable</VLAN-Reject-Unknown-Secure>
                <VLAN-Reject-Unknown>Disable</VLAN-Reject-Unknown>
                <VLAN-Search-Active>Disable</VLAN-Search-Active>
