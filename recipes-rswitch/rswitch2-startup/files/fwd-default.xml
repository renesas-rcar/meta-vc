        <Layer2-Forwarding>
            <MAX-Unsecure-Hash>100</MAX-Unsecure-Hash>>
            <MAX-Hash-Collision>4</MAX-Hash-Collision>
            <MAC-Hash-Equation>1</MAC-Hash-Equation>
            <MAX-Unsecure-VLAN-Entries>100</MAX-Unsecure-VLAN-Entries>
            <MAC-Table>
                <MAC-Entry>
                    <MAC>FF:FF:FF:FF:FF:FF</MAC>
                    <MAC-Learn-Disable>No</MAC-Learn-Disable>
                    <MAC-Dynamic-Learn>No</MAC-Dynamic-Learn>
                    <Security-Level>Yes</Security-Level>
                    <Dest-Src-Lock-Port>tsn4</Dest-Src-Lock-Port>
                    <Dest-Src-Lock-Port>tsn5</Dest-Src-Lock-Port>
                    <Dest-Src-Lock-Port>tsn6</Dest-Src-Lock-Port>
                    <Dest-Src-Lock-Port>tsn7</Dest-Src-Lock-Port>
                    <Dest-Src-Lock-CPU>Yes</Dest-Src-Lock-CPU>
                    <Src-Src-Lock-Port>tsn4</Src-Src-Lock-Port>
                    <Src-Src-Lock-Port>tsn5</Src-Src-Lock-Port>
                    <Src-Src-Lock-Port>tsn6</Src-Src-Lock-Port>
                    <Src-Src-Lock-Port>tsn7</Src-Src-Lock-Port>
                    <Src-Src-Lock-CPU>Yes</Src-Src-Lock-CPU>
                    <Dest-PortNumber>tsn4</Dest-PortNumber>
                    <Dest-PortNumber>tsn5</Dest-PortNumber>
                    <Dest-PortNumber>tsn6</Dest-PortNumber>
                    <Dest-PortNumber>tsn7</Dest-PortNumber>
