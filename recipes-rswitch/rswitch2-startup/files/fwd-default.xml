                <MAC-Reject-Unknown-Dest-Secure-Addr>Disable</MAC-Reject-Unknown-Dest-Secure-Addr>
                <MAC-Reject-Unknown-Dest-Addr>Disable</MAC-Reject-Unknown-Dest-Addr>
                <MAC-Dest-Search-Active>Enable</MAC-Dest-Search-Active>
                <IPV4-OTHER>Enable</IPV4-OTHER>
                <IPV4-TCP>Enable</IPV4-TCP>
                <IPV4-UDP>Enable</IPV4-UDP>
                <L3-Table-Active>Disable</L3-Table-Active>
            </Port-Specific>

            <Port-Specific>
